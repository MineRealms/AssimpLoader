#version 430 core
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Visibility { uint visible[]; };
layout(std430,binding=1) buffer Commands { uint commands[]; };
uniform uint count;
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index<count) commands[index*5u+1u]=visible[index];
}
