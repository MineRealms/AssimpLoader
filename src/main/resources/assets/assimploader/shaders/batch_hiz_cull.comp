#version 430 core
layout(local_size_x=64) in;
layout(binding=0) uniform sampler2D hierarchy;
struct Bounds { vec4 minimum;vec4 maximum; };
layout(std430,binding=0) readonly buffer BoundsBuffer { Bounds bounds[]; };
layout(std430,binding=1) writeonly buffer VisibilityBuffer { uint visible[]; };
uniform uint instanceCount;
uniform mat4 viewProjection;
uniform ivec2 baseSize;
uniform int levelCount;
uniform float depthBias;
bool bad(vec4 value) {return any(isnan(value))||any(isinf(value));}
void main() {
    uint index=gl_GlobalInvocationID.x;
    if(index>=instanceCount) return;
    visible[index]=1u;
    vec3 low=bounds[index].minimum.xyz,high=bounds[index].maximum.xyz;
    if(bad(vec4(low,1))||bad(vec4(high,1))||any(greaterThan(low,high))) return;
    vec2 first=vec2(1),last=vec2(0);float nearest=1.0;
    for(int corner=0;corner<8;corner++) {
        vec4 p=viewProjection*vec4((corner&1)==0?low.x:high.x,(corner&2)==0?low.y:high.y,(corner&4)==0?low.z:high.z,1);
        if(bad(p)||p.w<=0.00001||p.z<=-p.w||p.z>=p.w||any(lessThanEqual(p.xy,vec2(-p.w)))||any(greaterThanEqual(p.xy,vec2(p.w)))) return;
        vec3 ndc=p.xyz/p.w*.5+.5;
        first=min(first,ndc.xy);last=max(last,ndc.xy);nearest=min(nearest,ndc.z);
    }
    first-=1.0/vec2(baseSize);last+=1.0/vec2(baseSize);
    if(any(lessThanEqual(first,vec2(0)))||any(greaterThanEqual(last,vec2(1)))) return;
    float extent=max((last.x-first.x)*baseSize.x,(last.y-first.y)*baseSize.y);
    int level=clamp(int(floor(log2(max(1.0,extent)))),0,levelCount-1);
    ivec2 size=textureSize(hierarchy,level);
    ivec2 start=clamp(ivec2(floor(first*size)),ivec2(0),size-1),end=clamp(ivec2(floor(last*size)),ivec2(0),size-1);
    float maximum=0.0;
    for(int y=start.y;y<=end.y;y++) for(int x=start.x;x<=end.x;x++) {
        float value=texelFetch(hierarchy,ivec2(x,y),level).r;
        if(isnan(value)||isinf(value)||value<0.0||value>1.0) return;
        maximum=max(maximum,value);
    }
    if(nearest>maximum+depthBias) visible[index]=0u;
}
