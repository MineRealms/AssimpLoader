#version 430

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Deformed { float deformed[]; };
layout(std430, binding = 1) readonly buffer Indices { uint indices[]; };
layout(std430, binding = 2) buffer OculusVertices { uint vertices[]; };

uniform int triangleCount;
uniform int vertexStride;
uniform int positionOffset;
uniform int normalOffset;
uniform int tangentOffset;

vec3 position(uint vertex) {
    uint offset = vertex * 8u;
    return vec3(deformed[offset], deformed[offset + 1u], deformed[offset + 2u]);
}

vec3 normal(uint vertex) {
    uint offset = vertex * 8u + 3u;
    vec3 value = vec3(deformed[offset], deformed[offset + 1u], deformed[offset + 2u]);
    return dot(value, value) > 1e-20 ? normalize(value) : vec3(0.0, 1.0, 0.0);
}

vec2 uv(uint vertex) {
    uint offset = vertex * 8u + 6u;
    return vec2(deformed[offset], deformed[offset + 1u]);
}

uint signedByte(float value) {
    return uint(int(clamp(value, -1.0, 1.0) * 127.0)) & 255u;
}

// ENTITY's tangent starts at byte 50 in Oculus 1.8, crossing a uint boundary.
// One invocation owns an entire triangle, so these masked writes never race.
void packedBytes(uint byteOffset, uint value, uint count) {
    uint word = byteOffset / 4u;
    uint shift = (byteOffset & 3u) * 8u;
    uint bits = count * 8u;
    uint mask = count == 4u ? 0xffffffffu : (1u << bits) - 1u;
    uint lowMask = mask << shift;
    vertices[word] = (vertices[word] & ~lowMask) | ((value << shift) & lowMask);
    if (shift + bits > 32u) {
        uint highMask = mask >> (32u - shift);
        vertices[word + 1u] = (vertices[word + 1u] & ~highMask) | ((value >> (32u - shift)) & highMask);
    }
}

void main() {
    uint triangle = gl_GlobalInvocationID.x;
    if (triangle >= uint(triangleCount)) return;
    uint first = triangle * 3u;
    uint a = indices[first], b = indices[first + 1u], c = indices[first + 2u];
    vec3 edge1 = position(b) - position(a), edge2 = position(c) - position(a);
    vec2 delta1 = uv(b) - uv(a), delta2 = uv(c) - uv(a);
    float determinant = delta1.x * delta2.y - delta1.y * delta2.x;
    vec3 tangent = vec3(0.0), bitangent = vec3(0.0);
    if (abs(determinant) > 1e-12) {
        tangent = (edge1 * delta2.y - edge2 * delta1.y) / determinant;
        bitangent = (edge2 * delta1.x - edge1 * delta2.x) / determinant;
    }
    for (uint corner = 0u; corner < 3u; ++corner) {
        uint source = indices[first + corner];
        uint offset = (first + corner) * uint(vertexStride);
        vec3 p = position(source), n = normal(source);
        vec3 t = tangent - n * dot(n, tangent);
        if (dot(t, t) > 1e-20) t = normalize(t);
        else t = normalize(cross(abs(n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), n));
        // Match Oculus NormalHelper and shader packs' cross(tangent, normal) convention.
        float handedness = dot(cross(t, n), bitangent) < 0.0 ? -1.0 : 1.0;
        uint pos = (offset + uint(positionOffset)) / 4u;
        vertices[pos] = floatBitsToUint(p.x);
        vertices[pos + 1u] = floatBitsToUint(p.y);
        vertices[pos + 2u] = floatBitsToUint(p.z);
        packedBytes(offset + uint(normalOffset), signedByte(n.x) | (signedByte(n.y) << 8u) | (signedByte(n.z) << 16u), 3u);
        packedBytes(offset + uint(tangentOffset), signedByte(t.x) | (signedByte(t.y) << 8u) | (signedByte(t.z) << 16u)
            | (signedByte(handedness) << 24u), 4u);
    }
}
